generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model AutoService {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  phone       String
  email       String?
  address     String
  city        String
  description String?
  logo        String?
  workingHours Json?
  boxCount    Int      @default(2)
  isActive    Boolean  @default(true)
  tariff      String   @default("START")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  vehicles    Vehicle[]
  workOrders  WorkOrder[]
  services    ServiceCatalog[]
  bookings    Booking[]

  @@map("auto_services")
}

model User {
  id            String   @id @default(cuid())
  phone         String
  name          String
  role          String   @default("MECHANIC")
  autoServiceId String
  autoService   AutoService @relation(fields: [autoServiceId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrders    WorkOrder[]

  @@unique([phone, autoServiceId])
  @@map("users")
}

model Vehicle {
  id            String   @id @default(cuid())
  licensePlate  String
  vin           String?
  brand         String?
  model         String?
  year          Int?
  engineType    String?
  transmission  String?
  mileage       Int?
  ownerPhone    String
  ownerName     String?
  autoServiceId String
  autoService   AutoService @relation(fields: [autoServiceId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrders    WorkOrder[]

  @@unique([licensePlate, autoServiceId])
  @@index([ownerPhone])
  @@map("vehicles")
}

model WorkOrder {
  id            String   @id @default(cuid())
  number        String
  status        String   @default("PLANNED")
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  mechanicId    String?
  mechanic      User?    @relation(fields: [mechanicId], references: [id])
  autoServiceId String
  autoService   AutoService @relation(fields: [autoServiceId], references: [id])
  totalLabor    Float    @default(0)
  totalParts    Float    @default(0)
  totalAmount   Float    @default(0)
  plannedDate   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  mileage       Int?
  clientNotes   String?
  mechanicNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workItems     WorkItem[]
  parts         WorkOrderPart[]
  photos        WorkOrderPhoto[]
  defectReports DefectReport[]

  @@unique([number, autoServiceId])
  @@map("work_orders")
}

model WorkItem {
  id          String   @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  duration    Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("work_items")
}

model WorkOrderPart {
  id          String   @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        String
  article     String?
  quantity    Int      @default(1)
  pricePerUnit Float
  totalPrice  Float
  createdAt   DateTime @default(now())

  @@map("work_order_parts")
}

model WorkOrderPhoto {
  id          String   @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  category    String   @default("GENERAL")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("work_order_photos")
}

model DefectReport {
  id            String   @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title         String
  description   String
  severity      String   @default("MEDIUM")
  estimatedCost Float?
  status        String   @default("PENDING")
  clientApproved Boolean @default(false)
  approvedAt    DateTime?
  shareToken    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("defect_reports")
}

model ServiceCatalog {
  id            String   @id @default(cuid())
  autoServiceId String
  autoService   AutoService @relation(fields: [autoServiceId], references: [id])
  name          String
  category      String?
  description   String?
  basePrice     Float?
  duration      Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("service_catalog")
}

model Booking {
  id            String   @id @default(cuid())
  autoServiceId String
  autoService   AutoService @relation(fields: [autoServiceId], references: [id])
  clientName    String
  clientPhone   String
  clientNotes   String?
  licensePlate  String?
  vehicleBrand  String?
  vehicleModel  String?
  serviceName   String
  desiredDate   DateTime
  desiredTime   String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([desiredDate])
  @@map("bookings")
}

model AuthSession {
  id            String   @id @default(cuid())
  phone         String
  code          String
  purpose       String
  autoServiceId String?
  vehicleId     String?
  isUsed        Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([phone, code])
  @@map("auth_sessions")
}
